server {
    listen 80;
    server_name _;
    absolute_redirect off;
    root /usr/share/nginx/html;

    location = / {
        if ($query_string = "") {
            return 302 /?url=/partner-api.v0.yaml;
        }

        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}